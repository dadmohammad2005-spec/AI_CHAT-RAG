# ==========================================
# Multi-Tenant AI RAG SaaS Environment Config
# ==========================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-prod-ready-tenant-rag-engine-change-in-production-!$94%
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database (PostgreSQL with pgvector)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ai_rag_db
DB_USER=rag_admin
DB_PASSWORD=rag_secure_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI & LLM Provider Configuration
# Supported providers: openai, groq, huggingface, or mock (deterministic offline mock)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_DIMENSION=1536

# Enable deterministic mock embeddings & LLM fallback when OPENAI_API_KEY is not set or in offline dev
AI_FALLBACK_TO_MOCK=True

# RAG Pipeline Configuration
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35

# Default Tenant Quotas
DEFAULT_FREE_TOKEN_LIMIT=100000
DEFAULT_PRO_TOKEN_LIMIT=1000000
DEFAULT_ENTERPRISE_TOKEN_LIMIT=10000000
